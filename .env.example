# Postgres
POSTGRES_USER=alaboardage
POSTGRES_PASSWORD=alaboardage
POSTGRES_DB=alaboardage
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=5173

# Google OAuth
# 1. Aller sur https://console.cloud.google.com
# 2. Créer un projet (ou en sélectionner un existant)
# 3. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 4. Application type: Web application
# 5. Authorized redirect URIs: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT — générer une valeur aléatoire longue, ex: openssl rand -base64 32
JWT_SECRET=

# URLs
FRONTEND_URL=http://localhost:5173

# Alertes email — cron quotidien pour les recherches sauvegardées
# Si SMTP_HOST est vide, les résultats sont loggés en console (mode dégradé)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@alaboardage.local
ALERT_CRON=0 8 * * *
