// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobSource {
  GLASSDOOR
  HELLOWORK
  JEUNESDAVENIR
  JTMS
  LINKEDIN
  WTTJ
}

model Job {
  id              String         @id @default(cuid())
  externalId      String
  source          JobSource
  title           String
  company         String
  location        String
  description     String
  url             String
  datePosted      DateTime
  scrapedAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  establishment   Establishment? @relation(fields: [establishmentId], references: [siret])
  establishmentId String?

  @@unique([source, externalId])
  @@index([datePosted])
  @@index([company])
  @@index([source])
}

model Establishment {
  siret   String @id
  name    String
  address String
  city    String
  lat     Float
  lng     Float
  jobs    Job[]
}
