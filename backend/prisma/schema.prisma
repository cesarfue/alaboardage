// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobSource {
  GLASSDOOR
  HELLOWORK
  JEUNESDAVENIR
  JTMS
  LINKEDIN
  WTTJ
}

model Job {
  id              String           @id @default(cuid())
  externalId      String
  source          JobSource
  title           String
  company         String
  location        String
  description     String
  url             String
  datePosted      DateTime
  scrapedAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  establishment   Establishment?   @relation(fields: [establishmentId], references: [siret])
  establishmentId String?
  scores          JobScore[]
  interactions    JobInteraction[]
  views           JobView[]

  @@unique([source, externalId])
  @@index([datePosted])
  @@index([company])
  @@index([source])
}

model Establishment {
  siret   String @id
  name    String
  address String
  city    String
  lat     Float
  lng     Float
  jobs    Job[]
}

enum SkillLevel {
  PRIMARY
  SECONDARY
}

model Skill {
  id        String     @id @default(cuid())
  userId    String
  name      String
  level     SkillLevel
  createdAt DateTime   @default(now())
}

model JobScore {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  score     Float    @default(0)
  updatedAt DateTime @updatedAt

  job       Job      @relation(fields: [jobId], references: [id])

  @@unique([jobId, userId])
}

enum InteractionStatus {
  SAVED
  APPLIED
  REJECTED
}

model JobInteraction {
  id        String            @id @default(cuid())
  userId    String
  jobId     String
  status    InteractionStatus
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model JobView {
  id       String   @id @default(cuid())
  userId   String
  jobId    String
  viewedAt DateTime @default(now())
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model User {
  id           String   @id @default(cuid())
  googleId     String?  @unique
  email        String   @unique
  name         String
  picture      String?
  passwordHash String?
  createdAt    DateTime @default(now())
}

model UserPreference {
  userId      String   @id
  lastView    Json?
  listAnchors Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  name          String
  query         String
  location      String
  queries       String[]
  locations     String[]
  position      Int       @default(0)
  createdAt     DateTime  @default(now())
  emailAlerts   Boolean   @default(true)
  lastAlertAt   DateTime?
  lastCheckedAt DateTime?
  lastSeenAt    DateTime?
}
